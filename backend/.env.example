# Used when running the backend directly with "npm run dev" (no Docker).
PORT=4000
NODE_ENV=development
META_DATABASE_URL=postgres://postgres:postgres@localhost:5432/reconcileops_meta
DEMO_DATABASE_URL=postgres://postgres:postgres@localhost:5432/reconcileops_demo
CORS_ORIGIN=http://localhost:5173
API_TOKEN=
LOG_LEVEL=info

# Only for "npm test" integration tests. Use throwaway databases: they are wiped.
TEST_META_DATABASE_URL=postgres://postgres:postgres@localhost:5432/rops_meta_test
TEST_DEMO_DATABASE_URL=postgres://postgres:postgres@localhost:5432/rops_demo_test
