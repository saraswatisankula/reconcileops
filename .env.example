# Copy to .env and change the passwords. Never commit .env.

# --- Docker Compose ---
META_DB_USER=rops
META_DB_PASSWORD=change-me-meta
DEMO_DB_USER=demo
DEMO_DB_PASSWORD=change-me-demo
WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080

# Leave empty for local use. When set, every write request needs
# "Authorization: Bearer <token>" (enter it on the Settings page).
API_TOKEN=

LOG_LEVEL=info
